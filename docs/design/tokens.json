{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "agents-remote 设计令牌（唯一事实源）。颜色：$value = 浅色值，$extensions['mode.dark'] = 深色值；语义名两态一致，实现侧禁止写死 HEX。",
  "color": {
    "brand": {
      "primary": { "$type": "color", "$value": "#007AFF", "$extensions": { "mode.dark": "#0A84FF" }, "$description": "主蓝：链接 / 激活 Tab / 主按钮 / 光标 / 选中" },
      "primaryPressed": { "$type": "color", "$value": "#0A66C2", "$extensions": { "mode.dark": "#0A84FF" }, "$description": "主色按压态" }
    },
    "semantic": {
      "success": { "$type": "color", "$value": "#34C759", "$extensions": { "mode.dark": "#30D158" }, "$description": "运行 / 完成 / 允许按钮" },
      "successText": { "$type": "color", "$value": "#28A745", "$extensions": { "mode.dark": "#30D158" }, "$description": "浅底上的成功文字（对比度修正）" },
      "warning": { "$type": "color", "$value": "#FF9F0A", "$extensions": { "mode.dark": "#FF9F0A" }, "$description": "待审批 / 警示衬底" },
      "warningText": { "$type": "color", "$value": "#E08600", "$extensions": { "mode.dark": "#FF9F0A" }, "$description": "浅底上的警示文字" },
      "danger": { "$type": "color", "$value": "#FF3B30", "$extensions": { "mode.dark": "#FF453A" }, "$description": "错误 / 删除 / 中断 / 强写操作高亮" },
      "pin": { "$type": "color", "$value": "#AF52DE", "$extensions": { "mode.dark": "#BF5AF2" }, "$description": "置顶 / Agent 引用 / 思考标记" },
      "scrim": { "$type": "color", "$value": "rgba(0,0,0,0.40)", "$extensions": { "mode.dark": "rgba(0,0,0,0.45)" }, "$description": "浮层底压暗" }
    },
    "neutral": {
      "bgBase": { "$type": "color", "$value": "#F2F2F7", "$extensions": { "mode.dark": "#000000" }, "$description": "页面分组底" },
      "bgCanvas": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode.dark": "#000000" }, "$description": "工作区 / 输出流底" },
      "bgElevated": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode.dark": "#1C1C1E" }, "$description": "卡片 / 列表 / sheet" },
      "bgElevated2": { "$type": "color", "$value": "#F2F2F7", "$extensions": { "mode.dark": "#2C2C2E" }, "$description": "嵌套卡 / chips / 表单字段" },
      "bgElevated3": { "$type": "color", "$value": "#E9E9EB", "$extensions": { "mode.dark": "#3A3A3C" }, "$description": "分段控件容器底" },
      "bgTabbar": { "$type": "color", "$value": "#F8F8F8", "$extensions": { "mode.dark": "#1C1C1E" }, "$description": "Tab Bar 底（97% 不透明）" },
      "bgSidebar": { "$type": "color", "$value": "#F2F2F4", "$extensions": { "mode.dark": "#1C1C1F" }, "$description": "macOS/iPadOS Sidebar 材质（降级示意）" },
      "bgInspector": { "$type": "color", "$value": "#FAFAFB", "$extensions": { "mode.dark": "#101013" }, "$description": "macOS 右栏 Inspector 底" },
      "bgCodeblock": { "$type": "color", "$value": "#F6F6F8", "$extensions": { "mode.dark": "#0D0D0F" }, "$description": "代码块 / diff 底" },
      "bgTabstrip": { "$type": "color", "$value": "#ECECF0", "$extensions": { "mode.dark": "#141417" }, "$description": "桌面窗格 tab 条底" },
      "menu": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode.dark": "#2C2C2E" }, "$description": "上下文菜单 / 弹出面板底（配阴影）" },
      "inkTitle": { "$type": "color", "$value": "#000000", "$extensions": { "mode.dark": "#FFFFFF" }, "$description": "大标题 / 导航标题" },
      "inkPrimary": { "$type": "color", "$value": "#1C1C1E", "$extensions": { "mode.dark": "#F2F2F7" }, "$description": "一级正文 / 行文字" },
      "inkSecondary": { "$type": "color", "$value": "#8E8E93", "$extensions": { "mode.dark": "#98989F" }, "$description": "辅助 / 未激活 Tab / 占位" },
      "inkTertiary": { "$type": "color", "$value": "#C7C7CC", "$extensions": { "mode.dark": "#48484A" }, "$description": "极弱提示 / 分组符" },
      "sep": { "$type": "color", "$value": "#E5E5EA", "$extensions": { "mode.dark": "#38383A" }, "$description": "卡片描边 / 通用发丝分隔" },
      "sepStrong": { "$type": "color", "$value": "#D1D1D6", "$extensions": { "mode.dark": "#48484A" }, "$description": "强分隔 / 输入描边" },
      "sepRow": { "$type": "color", "$value": "#F0F0F2", "$extensions": { "mode.dark": "#2C2C2E" }, "$description": "行内分隔" },
      "fillSearch": { "$type": "color", "$value": "#E9E9EB", "$extensions": { "mode.dark": "#1C1C1E" }, "$description": "搜索框 / 输入框底（填充式）" },
      "fillSegmented": { "$type": "color", "$value": "#E9E9EB", "$extensions": { "mode.dark": "#1C1C1E" }, "$description": "分段容器底" },
      "segmentedThumb": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "mode.dark": "#3A3A3C" }, "$description": "分段滑块" },
      "fillSelected": { "$type": "color", "$value": "#DCEDFF", "$extensions": { "mode.dark": "rgba(10,132,255,0.22)" }, "$description": "Sidebar 选中行" },
      "tintBlue": { "$type": "color", "$value": "rgba(0,122,255,0.12)", "$extensions": { "mode.dark": "rgba(10,132,255,0.16)" }, "$description": "主色衬底（激活 pill / 任务卡）" },
      "tintGreen": { "$type": "color", "$value": "rgba(52,199,89,0.12)", "$extensions": { "mode.dark": "rgba(48,209,88,0.10)" }, "$description": "完成 / 子 agent 卡衬底" },
      "tintOrange": { "$type": "color", "$value": "rgba(255,159,10,0.12)", "$extensions": { "mode.dark": "rgba(255,159,10,0.13)" }, "$description": "审批托盘 / 待审批衬底" },
      "tintPurple": { "$type": "color", "$value": "rgba(175,82,222,0.12)", "$extensions": { "mode.dark": "rgba(191,90,242,0.14)" }, "$description": "置顶 / Wiki 引用衬底" },
      "tintRed": { "$type": "color", "$value": "rgba(255,59,48,0.10)", "$extensions": { "mode.dark": "rgba(255,69,58,0.12)" }, "$description": "错误卡 / diff 删除行衬底" },
      "tintDiffGreen": { "$type": "color", "$value": "rgba(52,199,89,0.12)", "$extensions": { "mode.dark": "rgba(48,209,88,0.10)" }, "$description": "diff 新增行衬底" },
      "homeIndicator": { "$type": "color", "$value": "rgba(0,0,0,0.85)", "$extensions": { "mode.dark": "rgba(255,255,255,0.80)" }, "$description": "Home 指示条" }
    }
  },
  "radius": {
    "bezel": { "$type": "dimension", "$value": "48px", "$description": "设备黑边（示意）" },
    "screen": { "$type": "dimension", "$value": "42px", "$description": "屏幕圆角（示意）" },
    "sheet": { "$type": "dimension", "$value": "20px", "$description": "sheet / 大弹层" },
    "card": { "$type": "dimension", "$value": "16px", "$description": "卡片 / 列表组" },
    "menu": { "$type": "dimension", "$value": "14px", "$description": "上下文菜单 / popover" },
    "input": { "$type": "dimension", "$value": "12px", "$description": "输入框 / 搜索框 / 表单字段" },
    "segmented": { "$type": "dimension", "$value": "10px", "$description": "分段容器" },
    "segmentedThumb": { "$type": "dimension", "$value": "8px", "$description": "分段滑块" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "胶囊（pill / 主按钮 / 进度条）" }
  },
  "space": {
    "screenEdge": { "$type": "dimension", "$value": "20px", "$description": "屏边距（@1x 示意；HTML 轨内容左右 16-20px，4/8 节奏）" },
    "cardGap": { "$type": "dimension", "$value": "12px", "$description": "卡片间距" },
    "rowGap": { "$type": "dimension", "$value": "8px", "$description": "行间距基数" },
    "rowHeight": { "$type": "dimension", "$value": "44px", "$description": "列表行高" },
    "inputHeight": { "$type": "dimension", "$value": "40px", "$description": "输入框高" }
  },
  "typography": {
    "stack": { "$type": "string", "$value": "-apple-system, 'SF Pro Text', 'PingFang SC', sans-serif", "$description": "Apple 端系统字体栈（SF Pro + 苹方），调系统 API" },
    "web-stack": { "$type": "string", "$value": "system-ui, -apple-system, 'SF Pro Text', 'PingFang SC', Roboto, 'Noto Sans SC', 'Microsoft YaHei', sans-serif", "$description": "Web/跨端回退栈" },
    "platform-stacks": { "$type": "string", "$value": "Apple=SF Pro+苹方；Android=Roboto+思源黑体；Windows=Segoe UI+微软雅黑", "$description": "多端回退策略；禁止捆绑字体与 CJK webfont" },
    "mono-stack": { "$type": "string", "$value": "ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, monospace", "$description": "终端 / 路径 / hash / 代码" },
    "line-height-ui": { "$type": "dimension", "$value": "1.4", "$description": "UI 文本行高" },
    "line-height-body": { "$type": "dimension", "$value": "2.0", "$description": "正文编辑区行高（16px 字 / 32px 行距示意）" },
    "web-dynamic-type": { "$type": "string", "$value": "字号用 rem（16px=1rem），随浏览器字号缩放 = 等价 Dynamic Type", "$description": "Web 端等价实现策略" },
    "large-title": { "$type": "dimension", "$value": "30px", "$description": "800；iOS Large Title（页首）" },
    "title": { "$type": "dimension", "$value": "17px", "$description": "600-700；iOS Headline / 导航标题" },
    "body": { "$type": "dimension", "$value": "16px", "$description": "400；iOS Body" },
    "callout": { "$type": "dimension", "$value": "15px", "$description": "iOS Callout" },
    "subhead": { "$type": "dimension", "$value": "14px", "$description": "iOS Subheadline" },
    "footnote": { "$type": "dimension", "$value": "13px", "$description": "iOS Footnote" },
    "caption": { "$type": "dimension", "$value": "12px", "$description": "iOS Caption" },
    "micro": { "$type": "dimension", "$value": "10.5px", "$description": "iOS Caption 2 / 工具组标签" },
    "weights": { "$type": "string", "$value": "400 常规 / 600 半粗 / 700 粗 / 800 特粗（仅 Large Title）", "$description": "字重档位" }
  },
  "icon": {
    "style": { "$type": "string", "$value": "SF Symbols rounded；单色矢量 24×24 网格、2px 圆头描边、中性灰阶", "$description": "线框图标规范；禁 emoji" },
    "mapping": { "$type": "string", "$value": "folder=文件夹/项目 · terminal=终端/工作台 · doc.text=文件 · square.grid.2x2=插件 · gearshape=设置 · arrow.triangle.branch=Git · book=Wiki · magnifyingglass=搜索 · plus=新建 · xmark=关闭 · ellipsis=溢出 · info.circle=信息 · arrow.clockwise=重试/刷新 · exclamationmark.triangle=警示 · pin=置顶 · pencil=重命名 · message=Chat · clock.arrow.circlepath=历史 · checkmark.shield=认证源 · sparkles=Claude · bolt=OMP · rectangle.split.2x1=分屏 · chevron.right.double=折叠右栏", "$description": "线框图标 → SF Symbols 对照（实现以此为准）" }
  },
  "component": {
    "tabBarHeight": { "$type": "dimension", "$value": "100px", "$description": "Tab Bar 高（含 Home 指示条）；4 Tab 内容中心 x=20+400/n*(i+0.5)" },
    "workspaceRow2": { "$type": "dimension", "$value": "30px", "$description": "工作台行2 实例+工具行高；行3 运行摘要 24px" },
    "approvalTray": { "$type": "dimension", "$value": "52px", "$description": "审批托盘高（按需出现，输入区上方）" },
    "inputBar": { "$type": "dimension", "$value": "40px", "$description": "会话/命令输入框高" },
    "instancePill": { "$type": "dimension", "$value": "30px", "$description": "实例 pill 高；激活蓝 tint 描边" },
    "sidebarRow": { "$type": "dimension", "$value": "34px", "$description": "桌面 Sidebar 行高（分组头 12/600）" },
    "stageMobile": { "$type": "dimension", "$value": "390×844", "$description": "HTML 轨手机舞台尺寸（含 12px 黑边 r54 + 灵动岛 + Home 指示条）" },
    "stageIpad": { "$type": "dimension", "$value": "1180×820", "$description": "HTML 轨 iPad 横屏全屏舞台（.stagepad；三栏 260/600/300，顶部 24px 状态区）" },
    "stageMac": { "$type": "dimension", "$value": "1240×710", "$description": "HTML 轨 Mac 窗口舞台（.stagewin；标题栏 52 + 状态栏 28，画布另加边距与标注区）" }
  }
}
