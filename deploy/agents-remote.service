# agents-remote 系统 service 模板（部署形态批，2026-10-27）。
# 注意：这是本机模板——User/WorkingDirectory/ExecStart 硬编码 deploy 用户的路径，
# 换机器/用户部署时按注释行逐项改（或改造成 %i/EnvironmentFile 参数化）。
#
# 安装（宿主机上执行一次）：
#   1. cd /home/deploy/workspace/agents-remote && bun run build   # api/dist + web/dist
#   2. sudo cp deploy/agents-remote.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now agents-remote
#
# 与 docker 形态的差异：配置走既有 ~/.agents-remote/config.yaml（必填值已就位时零 env）；
# 静态 web 由 api 内置 serve（WEB_DIST_DIR 指向仓库内构建产物）。端口沿用 config.yaml
# 的 api_port——与本机 ar-dev dev 服务（43011）并存时改 config.yaml 端口错开。
# 资源约束：MemoryMax/TasksMax 罩住整棵 agent 子进程树（claude/tmux/node）。
# 加固：基础项（写路径全在 /home/deploy 下，与 ProtectSystem=full 兼容；
# ProtectHome 不可用——home 即数据目录；重沙箱需实测 agent 子进程树后再加）。

[Unit]
Description=agents-remote (web control plane for remote agents)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/workspace/agents-remote
Environment=WEB_DIST_DIR=/home/deploy/workspace/agents-remote/web/dist
# ① 依赖版 claude 可达（2026-11-27 其他机器部署实测）：claude/tmux 都是裸名 spawn
#    （claude-runtime.ts / tmux-runtime.ts，走 PATH），系统服务默认 PATH 只有 /usr/bin
#    族——不前置 workspace node_modules/.bin 会 ENOENT 或落 .npm-global 旧版 claude
#    （实测落 2.1.212 旧版；修复后解析依赖版 ✓）。bun 同理（虽 ExecStart 绝对路径，
#    子进程树内 bun 裸名调用仍依赖此段）。
Environment=PATH=/home/deploy/workspace/agents-remote/node_modules/.bin:/home/deploy/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ② run dir 单源（2026-11-27 其他机器部署实测）：不设时 defaultRunDir 因系统服务无
#    XDG_RUNTIME_DIR 而 fallback 到 home——与 user-session 形态的 /run/user/1000 分裂，
#    token-secret/会话元数据两处不同源（实测会话清单一度消失）。
#    默认 = 持久路径（全新裸机推荐：无 /run/user/1000 存在性前置条件，重启不丢 token——
#    /run/user/1000 是 tmpfs）；若本机先以 dev/user-session 形态跑过、要衔接既有数据，
#    改用下行替换：Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=AGENTS_REMOTE_RUN_DIR=/home/deploy/.local/share/agents-remote/run
ExecStart=/home/deploy/.bun/bin/bun /home/deploy/workspace/agents-remote/api/dist/index.js
Restart=always
RestartSec=3
# 资源约束（用户目标：约束资源使用）
MemoryMax=4G
TasksMax=512
# 基础加固（无副作用项）
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
