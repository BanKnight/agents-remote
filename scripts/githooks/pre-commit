#!/usr/bin/env bash
set -euo pipefail

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "pre-commit: running quality gates"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# ── 快速通道（2026-09-30 用户拍板「提速」）──────────────────────────────
# 纯文档 commit（.md / .claude/** / docs/** 等非代码文件）不影响运行时，
# 全仓 typecheck+test（~100s）纯浪费——只跑 format:check + lint（~3s）。
# 判定是反向的：任一 staged 文件命中代码面（web/ api/ packages/ scripts/
# e2e/ 目录前缀，或代码扩展名）即走全门禁。宁可漏放行，不可错放行。
staged_files=$(git diff --cached --name-only)
if [ -n "$staged_files" ] && ! grep -qE '^(web|api|packages|scripts|e2e)/|\.(ts|tsx|js|mjs|cjs|json|css|html|sh|toml|ya?ml)$' <<<"$staged_files"; then
  echo ""
  echo "⚡ docs-only commit → fast path (format:check + lint, skip typecheck/test)"
  echo ""
  echo "▶ format:check"
  bun run format:check

  echo ""
  echo "▶ lint"
  bun run lint

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "pre-commit: fast path passed (docs-only)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  exit 0
fi

echo ""
echo "▶ format:check"
bun run format:check

echo ""
echo "▶ lint"
bun run lint

echo ""
echo "▶ typecheck"
bun run typecheck

echo ""
echo "▶ test"
# 全量 bun test 关进 2G cgroup（2026-11-03）：无限内存时与系统瞬时高压叠加（swap 耗尽 +
# chromium 探针残留），api test 进程中途被杀致 commit 假挂；限内存后稳定全绿。测试实测
# 峰值 ~500M，2G 上限余量充足，同时防测试挤穿机器。systemd-run --user 不可用（无 user
# session 的环境）时退回直接跑，不挡门禁。勿用 ulimit -v（虚拟地址限制对 rolldown WASM
# 会 OOM，见 dev-environment.md e2e 教训）。
if command -v systemd-run >/dev/null 2>&1 && systemd-run --scope --user -p MemoryMax=2G true 2>/dev/null; then
  systemd-run --scope --user -p MemoryMax=2G bun run test
else
  bun run test
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "pre-commit: all quality gates passed"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
